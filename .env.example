# Development only; local deploy writes these values to .env.local.
REGISTRY_NETWORK=local
REGISTRY_ADDRESS=
PUBLIC_RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_BLOCK=1

# Production overrides; otherwise the checked-in Sepolia manifest is used.
SEPOLIA_REGISTRY_ADDRESS=
SEPOLIA_DEPLOYMENT_BLOCK=
# This RPC URL is sent to browsers: no secret credentials.
SEPOLIA_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Server-side deployment script only:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Set securely in your hosting environment. Never use NEXT_PUBLIC_ for this.
PINATA_JWT=
APP_ORIGIN=
