{
  "name": "proofline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "compile:contract": "node scripts/compile.mjs",
    "test:contract": "node node_modules/@foundry-rs/forge/bin.mjs test -vv",
    "test:verify": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "chain": "node node_modules/@foundry-rs/anvil/bin.mjs --host 127.0.0.1",
    "deploy:local": "tsx scripts/deploy.ts local",
    "deploy:sepolia": "tsx scripts/deploy.ts sepolia",
    "wallet:setup": "tsx scripts/setup-wallet.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test": "npm run test:contract && npm run test:verify && npm run test:integration"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "multiformats": "14.0.5",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.56.3",
    "vinext": "1.0.0-beta.9",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@openzeppelin/contracts": "5.6.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "solc": "0.8.36",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "overrides": {
    "tmp": "^0.2.5"
  }
}
